{
  "name": "@leadfinder/portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5174 --strictPort",
    "format": "oxfmt src vite.config.ts playwright.config.ts",
    "format:check": "oxfmt --check src vite.config.ts playwright.config.ts",
    "lint": "oxlint src vite.config.ts playwright.config.ts",
    "lint:fix": "oxlint --fix src vite.config.ts playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "5.2.2",
    "@leadfinder/contracts": "workspace:*",
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.166.7",
    "axios": "1.13.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.35.0",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.2",
    "shadcn": "4.0.6",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.0",
    "jsdom": "28.1.0",
    "msw": "2.12.10",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "vitest": "4.1"
  }
