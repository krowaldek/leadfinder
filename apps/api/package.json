{
  "name": "@leadfinder/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "format": "oxfmt src prisma.config.ts prisma/seed.ts vitest.config.ts",
    "format:check": "oxfmt --check src prisma.config.ts prisma/seed.ts vitest.config.ts",
    "lint": "oxlint src prisma/seed.ts prisma.config.ts vitest.config.ts",
    "lint:fix": "oxlint --fix src prisma/seed.ts prisma.config.ts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "scraper:bk": "node --import tsx src/scrapers/bk/run.ts",
    "normalization:test": "node --import tsx src/normalization/run.ts",
    "normalization:backfill": "node --import tsx src/normalization/backfill.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.1.31",
    "@langchain/openai": "^1.2.12",
    "@leadfinder/contracts": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "11.1.16",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.16",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.16",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "axios": "1.13.6",
    "bcrypt": "6.0.0",
    "bullmq": "^5.70.4",
    "cookie-parser": "latest",
    "dotenv": "17.3.1",
    "ioredis": "^5.10.0",
    "p-limit": "^7.3.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.16",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "latest",
    "@types/express": "5.0.6",
    "@types/node": "25.3.5",
    "@types/passport-jwt": "4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "7.4.2",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
