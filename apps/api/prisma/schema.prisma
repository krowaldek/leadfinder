generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SystemRole {
  SUPER_ADMIN
  ADMIN
}

enum AccountType {
  PERSONAL
  COMPANY
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String
  firstName     String
  lastName      String
  systemRole    SystemRole           @default(ADMIN)
  accountType   AccountType          @default(PERSONAL)
  companyName   String?
  status        UserStatus           @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  refreshTokens RefreshTokenSession[]
  auditLogs     AuditLog[]           @relation("AuditActor")
}

model RefreshTokenSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  payload     String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

enum AnnouncementSource {
  BAZA_KONKURENCYJNOSCI
  E_ZAMOWIENIA
  PLATFORMA_ZAKUPOWA
}

enum AnnouncementStatus {
  OPEN
  CLOSED
  AWARDED
  UNKNOWN
}

model Announcement {
  id             String              @id @default(uuid()) @db.Uuid
  sourceSystem   AnnouncementSource
  externalId     String
  title          String
  description    String?
  url            String
  status         AnnouncementStatus  @default(OPEN)
  valueMin       Decimal?            @db.Decimal(15, 2)
  valueMax       Decimal?            @db.Decimal(15, 2)
  publishedAt    DateTime?
  deadlineAt     DateTime?
  embedding      Unsupported("vector(1536)")?
  rawData        Json
  detailedReport String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          AnnouncementItem[]

  @@unique([sourceSystem, externalId])
  @@index([sourceSystem])
  @@index([status])
  @@index([deadlineAt])
  @@map("announcements")
}

enum AnnouncementItemStatus {
  PENDING
  EMBEDDED
  ERROR
}

enum AnnouncementKind {
  DOSTAWA
  USLUGA
  ROBOTY_BUDOWLANE
  SZKOLENIE
  USLUGA_IT
  USLUGA_BADAWCZO_ROZWOJOWA
  DORADZTWO
  INNE
}

model AnnouncementItem {
  id                String                 @id @default(uuid()) @db.Uuid
  announcementId    String                 @db.Uuid
  itemIndex         Int
  title             String
  description       String?                @db.Text
  searchContext     String                 @db.Text
  embedding         Unsupported("vector(1536)")?
  price             Decimal?               @db.Decimal(15, 2)
  kind              AnnouncementKind?
  shortSummary      String?                @db.Text
  llmEstimatedValue Decimal?               @db.Decimal(15, 2)
  status            AnnouncementItemStatus @default(PENDING)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  announcement      Announcement           @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  clientMatches     ClientMatch[]

  @@unique([announcementId, itemIndex])
  @@index([announcementId])
  @@index([status])
  @@map("announcement_items")
}

enum AttachmentCacheStatus {
  SUCCESS
  FAILED
  UNSUPPORTED
}

model AttachmentCache {
  id               String                @id @default(uuid()) @db.Uuid
  cacheKey         String                @unique
  sourceSystem     AnnouncementSource?
  attachmentUrl    String
  attachmentName   String
  fileExt          String?
  contentType      String?
  extractedText    String?               @db.Text
  extractionMethod String?
  status           AttachmentCacheStatus @default(SUCCESS)
  failureReason    String?               @db.Text
  lastFetchedAt    DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([sourceSystem])
  @@index([status])
  @@map("attachment_cache")
}

model ScraperMetadata {
  id                  Int                 @id @default(autoincrement())
  providerName        AnnouncementSource  @unique
  lastSyncedAt        DateTime?
  lastProcessedItemId String?
  config              Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("scraper_metadata")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

enum GeographicScope {
  NATIONAL
  REGIONAL
  LOCAL
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ClientMatchStatus {
  NEW
  VIEWED
  DISMISSED
  SHORTLISTED
}

model Client {
  id                String          @id @default(uuid()) @db.Uuid
  companyName       String
  industry          String
  geographicScope   GeographicScope
  geographicDetails String?
  budgetDescription String
  contactPersonName String
  contactPersonRole String
  profileSummary    String          @db.Text
  profileEmbedding  Unsupported("vector(1536)")?
  negativeKeywords  String[]        @default([])
  status            ClientStatus    @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  matches           ClientMatch[]

  @@index([status])
  @@map("clients")
}

model ClientMatch {
  id                 String            @id @default(uuid()) @db.Uuid
  clientId           String            @db.Uuid
  announcementItemId String            @db.Uuid
  similarity         Float
  status             ClientMatchStatus @default(NEW)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  client             Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  announcementItem   AnnouncementItem  @relation(fields: [announcementItemId], references: [id], onDelete: Cascade)

  @@unique([clientId, announcementItemId])
  @@index([clientId])
  @@index([announcementItemId])
  @@index([status])
  @@map("client_matches")
}

// ---------------------------------------------------------------------------
// System Job Logs
// ---------------------------------------------------------------------------

enum JobLogType {
  SCRAPER
  EMBEDDING
  REPORT
}

enum JobLogStatus {
  STARTED
  COMPLETED
  FAILED
}

model JobLog {
  id          String       @id @default(cuid())
  type        JobLogType
  jobId       String?
  jobName     String
  status      JobLogStatus
  entityId    String?
  entityTitle String?
  payload     Json?
  result      Json?
  error       String?      @db.Text
  durationMs  Int?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([type])
  @@index([status])
  @@index([type, status])
  @@index([startedAt])
  @@map("job_logs")
}
