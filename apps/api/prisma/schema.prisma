generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SystemRole {
  SUPER_ADMIN
  ADMIN
}

enum AccountType {
  PERSONAL
  COMPANY
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String
  firstName     String
  lastName      String
  systemRole    SystemRole           @default(ADMIN)
  accountType   AccountType          @default(PERSONAL)
  companyName   String?
  status        UserStatus           @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  refreshTokens RefreshTokenSession[]
  auditLogs     AuditLog[]           @relation("AuditActor")
}

model RefreshTokenSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  payload     String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

enum AnnouncementSource {
  BAZA_KONKURENCYJNOSCI
  E_ZAMOWIENIA
  PLATFORMA_ZAKUPOWA
  INTERNAL
}

enum AnnouncementStatus {
  OPEN
  CLOSED
  AWARDED
  UNKNOWN
}

enum AnnouncementKind {
  DOSTAWA
  USLUGA
  ROBOTY_BUDOWLANE
  SZKOLENIE
  USLUGA_IT
  USLUGA_BADAWCZO_ROZWOJOWA
  DORADZTWO
  INNE
}

enum EmbeddingStatus {
  PENDING
  EMBEDDED
  ERROR
}

/// Flat announcement record. Multi-part tenders are stored as separate rows sharing
/// the same externalId but with different partIndex values (0, 1, 2, …).
model Announcement {
  id                String             @id @default(uuid()) @db.Uuid
  sourceSystem      AnnouncementSource
  externalId        String
  /// 0 for single-part tenders; 0, 1, 2 … for each lot/part of a multi-part tender.
  partIndex         Int                @default(0)
  title             String
  aiTitle           String?            @db.Text
  description       String?            @db.Text
  url               String
  status            AnnouncementStatus @default(OPEN)
  valueMin          Decimal?           @db.Decimal(15, 2)
  valueMax          Decimal?           @db.Decimal(15, 2)
  publishedAt       DateTime?
  deadlineAt        DateTime?
  location          String?            @db.Text
  contractingAuthority String?         @db.Text
  /// Condensed text used as embedding input (title + description + CPV codes etc.)
  searchContext     String             @default("") @db.Text
  kind              AnnouncementKind?
  detailedReport    String?            @db.Text
  llmEstimatedValue Decimal?           @db.Decimal(15, 2)
  embeddingStatus   EmbeddingStatus    @default(PENDING)
  embedding         Unsupported("vector(1536)")?
  rawData           Json
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  matches           ClientMatch[]

  @@unique([sourceSystem, externalId, partIndex])
  @@index([sourceSystem])
  @@index([status])
  @@index([deadlineAt])
  @@index([embeddingStatus])
  @@map("announcements")
}

enum AttachmentCacheStatus {
  SUCCESS
  FAILED
  UNSUPPORTED
}

model AttachmentCache {
  id               String                @id @default(uuid()) @db.Uuid
  cacheKey         String                @unique
  sourceSystem     AnnouncementSource?
  attachmentUrl    String
  attachmentName   String
  fileExt          String?
  contentType      String?
  extractedText    String?               @db.Text
  extractionMethod String?
  status           AttachmentCacheStatus @default(SUCCESS)
  failureReason    String?               @db.Text
  lastFetchedAt    DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([sourceSystem])
  @@index([status])
  @@map("attachment_cache")
}

model ScraperMetadata {
  id                  Int                 @id @default(autoincrement())
  providerName        AnnouncementSource  @unique
  lastSyncedAt        DateTime?
  lastProcessedItemId String?
  config              Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("scraper_metadata")
}

// ---------------------------------------------------------------------------
// Clients, Projects, Topics
// ---------------------------------------------------------------------------

enum GeographicScope {
  NATIONAL
  REGIONAL
  LOCAL
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ClientMatchStatus {
  NEW
  VIEWED
  DISMISSED
  SHORTLISTED
}

model Client {
  id                String          @id @default(uuid()) @db.Uuid
  companyName       String
  industry          String
  geographicScope   GeographicScope
  geographicDetails String?
  budgetDescription String
  contactPersonName String
  contactPersonRole String
  status            ClientStatus    @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  projects          Project[]

  @@index([status])
  @@map("clients")
}

/// A procurement initiative belonging to a client (e.g. "IT equipment Q3 2026").
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@index([clientId])
  @@map("projects")
}

/// A specific matching subject within a project.
/// The `prompt` text is written by the user and gets vectorised for semantic matching.
model Topic {
  id               String          @id @default(uuid()) @db.Uuid
  projectId        String          @db.Uuid
  title            String
  /// Free-form description used to build the embedding (user-written prompt).
  prompt           String          @db.Text
  embedding        Unsupported("vector(1536)")?
  embeddingStatus  EmbeddingStatus @default(PENDING)
  negativeKeywords String[]        @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  matches ClientMatch[]

  @@index([projectId])
  @@index([embeddingStatus])
  @@map("topics")
}

/// Links a Topic to a matching Announcement (result of semantic search).
model ClientMatch {
  id             String            @id @default(uuid()) @db.Uuid
  topicId        String            @db.Uuid
  announcementId String            @db.Uuid
  similarity     Float
  status         ClientMatchStatus @default(NEW)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  topic        Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([topicId, announcementId])
  @@index([topicId])
  @@index([announcementId])
  @@index([status])
  @@map("client_matches")
}

// ---------------------------------------------------------------------------
// System Job Logs
// ---------------------------------------------------------------------------

enum JobLogType {
  SCRAPER
  EMBEDDING
  MATCHING
  REPORT
  AI_PROMPT
}

enum JobLogStatus {
  STARTED
  COMPLETED
  FAILED
}

model JobLog {
  id          String       @id @default(cuid())
  type        JobLogType
  jobId       String?
  jobName     String
  status      JobLogStatus
  entityId    String?
  entityTitle String?
  payload     Json?
  result      Json?
  error       String?      @db.Text
  durationMs  Int?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([type])
  @@index([status])
  @@index([type, status])
  @@index([startedAt])
  @@map("job_logs")
}
